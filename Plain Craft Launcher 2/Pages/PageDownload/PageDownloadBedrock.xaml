<local:MyPageRight x:Class="PCL.PageDownloadBedrock"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <local:MyButton x:Name="BtnBackSelect" Text="&lt; 返回选择页面" MinWidth="118" Margin="0,0,15,0"
                                Click="BtnBackSelect_Click" />
                <Image Source="pack://application:,,,/images/Custom/BedrockIconLarge.png" Width="28" Height="28"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Text="  基岩版（Bedrock）下载中心" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TextFolderInfo" Text="" Opacity="0.65" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />

            <!-- 版本下载 -->
            <local:MyCard Margin="0,15,0,0" Title="版本下载" UseAnimation="False">
                <StackPanel Margin="25,30,25,20">
                    <!-- 最新正式版 / 最新预览版 -->
                    <StackPanel x:Name="PanLatest" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnRefresh" Text="刷新列表" MinWidth="90"
                                        Click="BtnRefresh_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TextVersionHint" Text="正在加载版本列表……" Opacity="0.7" Margin="0,12,0,0"
                               FontSize="13" TextWrapping="Wrap" />
                    <!-- 折叠分区：正式版 / 预览版 / Beta 版 -->
                    <local:MyCard x:Name="CardGroupRelease" Title="正式版" UseAnimation="False" Margin="0,12,0,10" CanSwap="True" />
                    <local:MyCard x:Name="CardGroupPreview" Title="预览版" UseAnimation="False" Margin="0,0,0,10" CanSwap="True" />
                    <local:MyCard x:Name="CardGroupBeta" Title="Beta 版" UseAnimation="False" Margin="0,0,0,0" CanSwap="True" />
                </StackPanel>
            </local:MyCard>

            <!-- 下载任务 -->
            <local:MyCard Margin="0,15,0,0" Title="下载任务" UseAnimation="False" Visibility="Collapsed">
                <StackPanel Margin="25,30,25,20">
                    <StackPanel x:Name="PanTasks">
                        <TextBlock Text="暂无进行中的任务。" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 已安装状态（精简） -->
            <local:MyCard Margin="0,15,0,15" Title="已安装状态" UseAnimation="False" Visibility="Collapsed">
                <StackPanel Margin="25,30,25,20">
                    <TextBlock x:Name="TextInstalled" Text="正在检测……" TextWrapping="Wrap" FontSize="14" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnLaunch" Text="启动基岩版" MinWidth="110" Margin="0,0,10,0"
                                        Click="BtnLaunch_Click" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开下载文件夹" MinWidth="120" Margin="0,0,10,0"
                                        Click="BtnOpenFolder_Click" />
                        <local:MyButton x:Name="BtnInstallUwp" Text="安装所选 UWP 包" MinWidth="130"
                                        Click="BtnInstallUwp_Click" />
                    </StackPanel>
                    <local:MyHint x:Name="HintInstalled" Text="" HasBorder="False" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
