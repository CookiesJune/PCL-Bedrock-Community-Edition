<local:MyPageRight x:Class="PCL.PageDownloadHome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <TextBlock Text="下载中心" FontSize="20" FontWeight="Bold" Margin="2,4,0,0" />

            <TextBlock Text="选择要下载的 Minecraft 游戏，均可直接下载与启动（商店游戏需微软账号并持有正版授权）。" Opacity="0.65" FontSize="13"
                       Margin="2,10,0,16" TextWrapping="Wrap" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Java -->
                <local:MyCard Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" UseAnimation="False" Title="Java 版">
                    <StackPanel Margin="22,40,22,18" MouseLeftButtonDown="Java_Click" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="pack://application:,,,/images/Blocks/Grass.png" Width="52" Height="52" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Java 版（原版启动器）" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="下载 Java 版游戏本体与各个版本。" Opacity="0.65" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <!-- 基岩版 -->
                <local:MyCard Grid.Row="0" Grid.Column="1" Margin="10,0,0,10" UseAnimation="False" Title="基岩版">
                    <StackPanel Margin="22,40,22,18" MouseLeftButtonDown="Bedrock_Click" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="pack://application:,,,/images/Custom/BedrockIconLarge.png" Width="52" Height="52" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="基岩版（Bedrock）" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="下载 UWP / GDK 基岩版，支持各版本与实例管理。" Opacity="0.65" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <!-- 地下城与传奇已按要求移除（仅保留 Java / 基岩版横幅） -->
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
