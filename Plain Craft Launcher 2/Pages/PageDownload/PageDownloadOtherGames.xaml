<local:MyPageRight x:Class="PCL.PageDownloadOtherGames"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <TextBlock Text="地下城 / 传奇 / 教育版" FontSize="16" FontWeight="Bold" Margin="2,4,0,0"
                       Opacity="0.85" />

            <!-- 下载任务 -->
            <local:MyCard Margin="0,15,0,0" Title="下载任务" UseAnimation="False">
                <StackPanel Margin="25,30,25,20">
                    <TextBlock x:Name="TextDlTask" Text="暂无进行中的下载。可直接下载并安装商店游戏（需微软账号且账号持有正版授权）。" Opacity="0.6" TextWrapping="Wrap" />
                    <ProgressBar x:Name="BarDlTask" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TextDlDetail" Text="" Opacity="0.6" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>

            <!-- 地下城 -->
            <local:MyCard Margin="0,15,0,0" Title="Minecraft Dungeons（地下城）" UseAnimation="False">
                <StackPanel Margin="25,35,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TextDungeonsStatus" Text="正在检测安装状态……" TextWrapping="Wrap" FontSize="15" />
                            <TextBlock x:Name="TextDungeonsUpdate" Text="" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" FontSize="13" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" ItemHeight="40" Margin="12,0,0,0">
                            <local:MyButton x:Name="BtnDungeonsLaunch" MinWidth="90" Text="启动" Margin="0,0,10,10"
                                            Click="BtnDungeonsLaunch_Click" />
                            <local:MyButton x:Name="BtnDungeonsDownload" MinWidth="100" Text="直接下载" Margin="0,0,10,10"
                                            Click="BtnDungeonsDownload_Click" />
                            <local:MyButton x:Name="BtnDungeonsStore" MinWidth="90" Text="商店" Margin="0,0,10,10"
                                            Click="BtnDungeonsStore_Click" />
                            <local:MyButton x:Name="BtnDungeonsUpdate" MinWidth="90" Text="检查更新" Margin="0,0,10,10"
                                            Click="BtnDungeonsUpdate_Click" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 传奇 -->
            <local:MyCard Margin="0,15,0,0" Title="Minecraft Legends（传奇）" UseAnimation="False">
                <StackPanel Margin="25,35,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TextLegendsStatus" Text="正在检测安装状态……" TextWrapping="Wrap" FontSize="15" />
                            <TextBlock x:Name="TextLegendsCheck" Text="" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" FontSize="13" />
                            <TextBlock x:Name="TextLegendsUpdate" Text="" TextWrapping="Wrap" Opacity="0.6" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" ItemHeight="40" Margin="12,0,0,0">
                            <local:MyButton x:Name="BtnLegendsLaunch" MinWidth="90" Text="启动" Margin="0,0,10,10"
                                            Click="BtnLegendsLaunch_Click" />
                            <local:MyButton x:Name="BtnLegendsCheck" MinWidth="110" Text="正版校验" Margin="0,0,10,10"
                                            Click="BtnLegendsCheck_Click" />
                            <local:MyButton x:Name="BtnLegendsDownload" MinWidth="100" Text="直接下载" Margin="0,0,10,10"
                                            Click="BtnLegendsDownload_Click" />
                            <local:MyButton x:Name="BtnLegendsStore" MinWidth="90" Text="商店" Margin="0,0,10,10"
                                            Click="BtnLegendsStore_Click" />
                            <local:MyButton x:Name="BtnLegendsUpdate" MinWidth="90" Text="检查更新" Margin="0,0,10,10"
                                            Click="BtnLegendsUpdate_Click" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 教育版 -->
            <local:MyCard Margin="0,15,0,0" Title="Minecraft Education（教育版）" UseAnimation="False">
                <StackPanel Margin="25,35,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TextEducationStatus" Text="正在检测安装状态……" TextWrapping="Wrap" FontSize="15" />
                            <TextBlock x:Name="TextEducationUpdate" Text="" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" FontSize="13" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" ItemHeight="40" Margin="12,0,0,0">
                            <local:MyButton x:Name="BtnEducationLaunch" MinWidth="90" Text="启动" Margin="0,0,10,10"
                                            Click="BtnEducationLaunch_Click" />
                            <local:MyButton x:Name="BtnEducationDownload" MinWidth="100" Text="直接下载" Margin="0,0,10,10"
                                            Click="BtnEducationDownload_Click" />
                            <local:MyButton x:Name="BtnEducationStore" MinWidth="90" Text="商店" Margin="0,0,10,10"
                                            Click="BtnEducationStore_Click" />
                            <local:MyButton x:Name="BtnEducationUpdate" MinWidth="90" Text="检查更新" Margin="0,0,10,10"
                                            Click="BtnEducationUpdate_Click" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 说明 -->
            <local:MyCard Margin="0,15,0,15" Title="说明" UseAnimation="False">
                <StackPanel Margin="25,30,25,25">
                    <local:MyHint x:Name="HintInfo" Text="" HasBorder="False" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0" FontSize="12"
                               Text="• 这三款游戏通过微软商店分发，启动需系统已安装对应 UWP/MSIX 包。&#10;• 「直接下载」会从微软商店公开接口获取安装包并下载到本地，再调用系统安装；安装与启动均以「已登录微软账号 + 账号持有正版授权」为前提（正版验证）。&#10;• 「传奇」启动前会做正版校验：要求已登录微软账号且本地授权有效。&#10;• 「检查更新」通过微软商店公开接口尽力查询最新版本，失败时静默跳过。" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
